#Main {
    background-color: slategrey;
    padding: 8px;
}

#Top {
    display: flex;
    flex-direction: row;
}

#Top > #Title {
    padding: 0 10px;
    background-color: white;
    font-size: 25px;
    border-top-left-radius: 10px;
}

#Top > #Cross {
    margin: 0;
    border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 0 10px;
    background-color: white;
    border-top-right-radius: 10px;
}

#Top > #Cross > Image {
    width: 16px;
    height: 16px;
}


#Header {
    max-height: 150px;
    background-color: white;
    padding: 20px;
    border-top-right-radius: 10px;
}

#Header > #Url {
    min-height: 50px;
    background-color: rgb(74, 74, 74);
    color: white;
    border-radius: 5px;
    padding-left: 20px;
    display: flex;
    justify-content: center;
    font-size: 20px;
}

#Header > #Url > Label {
    margin: 0;
    padding: 0;
}

#Header > #Tabs {
    margin-top: 20px;
    min-height: 10px;
    display: flex;
    flex-direction: row;
    max-width: 40%;
}

#Header > #Tabs > Button {
    display: flex;
    flex-direction: row;
    align-items: center;
    max-width: 50%;
    max-height: 20px;
    background-color: transparent;
    border-color: transparent;
    font-size: 18px;
    transition: all ease-in-out 300ms;
}

#Header > #Tabs > Button:hover {
    scale: 1.1%;
    transition: all ease-in-out 300ms;
}

#Header > #Tabs > Button > Image {
    width: 32px;
    height: 32px;
}

.first-item {
    margin-right: 20px;
}

#MainView {
    background-color: white;
    padding-left: 20;
    border-bottom-left-radius: 20;
    border-bottom-right-radius: 20;
}

#TruckView {
    display: none;
}
