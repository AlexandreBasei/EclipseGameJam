#TagContainer {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 75;
    font-size: 12;
    height: 20;
    background-color: lightskyblue;
    padding: 2;
    margin: 0;
    border-radius: 10;
    margin-left: 10;
}

#TagContainer > #TagName {
    color: black;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}