#MainContainer {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-color: rgba(0 0 0 0.7);
}

#Tablet {
    height: 600px;
    width: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: white;
    border-radius: 10;
    border-width: 4px;
    border-color: black;
}

#Title {
    font-size: 32px;
}

#CommandContainer {
    padding: 4px;
    max-width: 18%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#ContainerName {
    height: auto;
}

#CrossButton {
    position: absolute;
    right: 4px;
    top: 4px;
    border-width: 0px;
    border-color: transparent;
    background-color: slategrey;
    border-radius: 100;
    padding: 8;
    transition: all ease-in-out 300ms;
}

#CrossButton > Image {
    width: 24px;
    height: 24px;
}

#CrossButton:hover {
    scale: 1.1;
}