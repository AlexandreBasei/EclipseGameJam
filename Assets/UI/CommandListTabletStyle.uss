#MainContainer {
    display: flex;
    flex-direction: row;
}

#Title {
    color: white;
    font-size: 20px;
}

#CommandContainer {
    padding: 4px;
    background-color: rgba(0 0 0 0.7);
    max-width: 18%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#ContainerName {
    height: auto;
}