#MainContainer {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-color: rgba(0 0 0 0.7);
}

#Tablet {
    height: 600px;
    width: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: white;
    border-radius: 10;
    border-width: 4px;
    border-color: black;
}

#Title {
    font-size: 32px;
}

#CommandContainer {
    padding: 4px;
    max-width: 18%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#ContainerName {
    height: auto;
}